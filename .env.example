# DealMoa runtime environment example.
# Copy to .env for local development and replace placeholder secrets.
# Production deployment target:
# - Web: Vercel project rooted at apps/web.
# - API/services: Railway.

API_ENV=local
API_PROJECT_NAME=DealMoa API
API_V1_PREFIX=/api/v1
API_PORT=8000
PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:3100

WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Backward-compatible Docker Compose local alias. Vercel uses NEXT_PUBLIC_API_BASE_URL.
WEB_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

POSTGRES_DB=dealmoa
POSTGRES_USER=dealmoa
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://dealmoa:replace-with-local-password@postgres:5432/dealmoa

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://elasticsearch:9200

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_PORT=9092
REDPANDA_ADMIN_PORT=9644
KAFKA_DOMAIN_EVENTS_TOPIC=dealmoa.domain-events
CONSUMER_POLL_INTERVAL_SECONDS=1
CONSUMER_BATCH_SIZE=100

CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

OAUTH_GOOGLE_CLIENT_ID=replace-with-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
OAUTH_KAKAO_CLIENT_ID=replace-with-kakao-client-id
OAUTH_KAKAO_CLIENT_SECRET=replace-with-kakao-client-secret
OAUTH_NAVER_CLIENT_ID=replace-with-naver-client-id
OAUTH_NAVER_CLIENT_SECRET=replace-with-naver-client-secret

JWT_SECRET_KEY=replace-with-local-jwt-secret-minimum-32-bytes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
AUTH_REFRESH_COOKIE_NAME=dm_refresh_token
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAMESITE=lax
